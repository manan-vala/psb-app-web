# Backend base URL (the Express + Socket.io service deployed on Render).
# Leave unset to fall back to the production Render URL baked into src/services/api.ts.
NEXT_PUBLIC_API_URL=https://psb-back.onrender.com

# Neon Postgres connection string, used server-side only (Route Handlers under
# src/app/api/auth/*). Get this from the Neon console or the Neon MCP
# connector — project "PSB" (cold-term-57080986). Use the pooled connection
# string (the one with "-pooler" in the hostname) since Vercel functions are
# short-lived and each invocation opens a fresh connection.
DATABASE_URL=postgresql://neondb_owner:<password>@ep-misty-unit-ay5b81fx-pooler.c-5.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# Face ID (hybrid_face_auth_spec_v2.md) — the separate psb-face-api Python
# service deployed from the `ml/face_api` folder. Required for /face-enroll
# and the StepUpModal's face verification step; without it, StepUpModal
# falls back to password re-entry.
FACE_API_URL=https://psb-face-api.onrender.com
FACE_API_SECRET=<generate with: openssl rand -hex 32 — must match the same value set on psb-face-api>

# Auto sign-in for the /face-id-test diagnostics console.
#
# The console needs a session to run its enroll/verify phases, so it signs
# itself into a seeded demo account (users.is_demo — see migrations/004) on
# load and signs out again when you navigate away.
#
# Unset, this is ON in development and OFF in production, because an
# always-available endpoint that mints sessions is also an unauthenticated
# route to the face service, which has no rate limiting of its own. Set it to
# true on the deployed environment only when you actually want the hosted
# console to work without a manual login.
#
# DEMO_AUTH_ENABLED=true
